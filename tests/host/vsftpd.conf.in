listen=YES
listen_port=2121
listen_address=127.0.0.1
anonymous_enable=NO
local_enable=YES
write_enable=YES
pasv_enable=YES
pasv_min_port=40000
pasv_max_port=40100
pasv_address=127.0.0.1
ssl_enable=YES
force_local_logins_ssl=YES
force_local_data_ssl=YES
require_ssl_reuse=YES
ssl_tlsv1=NO
ssl_sslv2=NO
ssl_sslv3=NO
ssl_ciphers=HIGH
rsa_cert_file=@PKI@/chain.pem
rsa_private_key_file=@PKI@/srv.key
secure_chroot_dir=/var/run/vsftpd/empty
pam_service_name=vsftpd
seccomp_sandbox=NO
background=YES
xferlog_enable=YES
vsftpd_log_file=@WORK@/vsftpd.log
log_ftp_protocol=YES
debug_ssl=YES
