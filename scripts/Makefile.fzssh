# fzssh 1.4.0 (its crypt, core and client parts) as one static library, in
# place of fzssh's meson build, on GFOpenCrypto (patch fzssh-0001). Run by
# scripts/build-fz.sh with SRC (fzssh's tree), OBJ, SYS (the sysroot with
# libfilezilla and the GFOpenCrypto stub), TC.
# Copyright (c) 2026 AmiCradle Team

CC  := $(TC)/bin/m68k-amigaos-gcc
CXX := $(TC)/bin/m68k-amigaos-g++
AR  := $(TC)/bin/m68k-amigaos-ar
OPT := -m68040 -O2 -noixemul -fno-delete-null-pointer-checks
CXXFLAGS := $(OPT) -std=gnu++20 -include fzamiga.h -I$(OBJ)/include -I$(SRC)/lib -I$(SYS)/include -I$(OBJ) -Wall -Wno-unused

CRYPT  := crypt/bcrypt crypt/blowfish crypt/mlkem crypt/mlkem_impl crypt/util
CORE   := asn1 buffer_util cipher ecc dh connection_protocol mac mpz pubkey privkey privkey_import \
          transport sftp ssh userauth version
CLIENT := client/agent client/client client/connection_protocol client/sftp_client client/transport client/userauth

all: $(SYS)/lib/libfzssh.a

$(OBJ)/crypt/%.o: $(SRC)/lib/crypt/%.cpp
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) -DBUILDING_FZSSH_CRYPT -c $< -o $@
$(OBJ)/client/%.o: $(SRC)/lib/client/%.cpp
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) -DBUILDING_FZSSH_CLIENT -c $< -o $@
$(OBJ)/core/%.o: $(SRC)/lib/%.cpp
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) -DBUILDING_FZSSH -c $< -o $@

FZOBJ := $(CRYPT:crypt/%=$(OBJ)/crypt/%.o) $(CORE:%=$(OBJ)/core/%.o) $(CLIENT:client/%=$(OBJ)/client/%.o)
$(FZOBJ): $(OBJ)/include/fzssh/version.hpp $(OBJ)/config.hpp

$(SYS)/lib/libfzssh.a: $(FZOBJ)
	rm -f $@; $(AR) rcs $@ $^
	mkdir -p $(SYS)/include/fzssh/sftp
	cp $(SRC)/lib/fzssh/*.hpp $(OBJ)/include/fzssh/version.hpp $(SYS)/include/fzssh/
	cp $(SRC)/lib/fzssh/sftp/*.hpp $(SYS)/include/fzssh/sftp/

.PHONY: all
