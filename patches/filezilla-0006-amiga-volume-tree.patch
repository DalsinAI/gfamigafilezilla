AmigaOS: the local directory tree starts from the volumes. libfilezilla
lists them as the entries of "/" (its patch 0006); a volume's name
("Work:") is a whole path, so it takes no "/" before or after it, and
AmigaDOS names match whatever their case.

--- a/src/interface/LocalTreeView.cpp
+++ b/src/interface/LocalTreeView.cpp
@@ -27,6 +27,33 @@
 #include "osx_sandbox_userdirs.h"
 #endif
 
+namespace {
+// AmigaOS: "/" is the list of volumes (libfilezilla lists them there), and
+// a volume's name ("Work:") is a whole path of its own, which takes no
+// separator after it: "Work:" + "a" is "Work:a".
+std::wstring fz_child(std::wstring const& dir, std::wstring const& name)
+{
+#ifdef __AMIGA__
+	if (dir == L"/" && !name.empty() && name.back() == ':') {
+		return name;
+	}
+#endif
+	return dir + name;
+}
+
+std::wstring fz_child_dir(std::wstring const& dir, std::wstring const& name)
+{
+	std::wstring ret = fz_child(dir, name);
+#ifdef __AMIGA__
+	if (!ret.empty() && ret.back() == ':') {
+		return ret;
+	}
+#endif
+	ret += fz::local_filesys::path_separator;
+	return ret;
+}
+}
+
 #include <algorithm>
 
 using namespace std::literals;
