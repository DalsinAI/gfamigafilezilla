 namespace fz {
 
+namespace {
+size_t constexpr GCM_IV_SIZE = 12;
+size_t constexpr GCM_DIGEST_SIZE = 16;
+size_t constexpr SHA256_DIGEST_SIZE = 32;
+
+class gcm_aes256 final
+{
+public:
+	gcm_aes256(uint8_t const* key, uint8_t const* iv)
+	{
+		memcpy(key_, key, 32);
+		uint8_t zero[16]{};
+		memset(h_, 0, 16);
+		oc_aes(h_, 16, key_, 32, zero, OC_AES_ECB_ENCRYPT);
+		memcpy(j0_, iv, 12);
+		j0_[12] = 0; j0_[13] = 0; j0_[14] = 0; j0_[15] = 1;
+		memcpy(ctr_, j0_, 16);
+		ctr_[15] = 2;
+	}
+
+	~gcm_aes256()
+	{
+		oc_cleanse(this, sizeof(*this));
+	}
+
+	void update(uint8_t const* ad, size_t size)
+	{
+		oc_ghash(y_, h_, ad, size);
+		ad_size_ = size;
+	}
+
+	void encrypt(uint8_t* out, uint8_t const* in, size_t size)
+	{
+		if (out != in) {
+			memmove(out, in, size);
+		}
+		oc_aes(out, size, key_, 32, ctr_, OC_AES_CTR);
+		oc_ghash(y_, h_, out, size);
+		size_ = size;
+	}
+
+	void decrypt(uint8_t* out, uint8_t const* in, size_t size)
+	{
+		oc_ghash(y_, h_, in, size);
+		if (out != in) {
+			memmove(out, in, size);
+		}
+		oc_aes(out, size, key_, 32, ctr_, OC_AES_CTR);
+		size_ = size;
+	}
+
+	void digest(uint8_t* tag)
+	{
+		uint8_t lens[16];
+		uint64_t const a = static_cast<uint64_t>(ad_size_) * 8;
+		uint64_t const c = static_cast<uint64_t>(size_) * 8;
+		for (int i = 0; i < 8; ++i) {
+			lens[7 - i] = static_cast<uint8_t>(a >> (8 * i));
+			lens[15 - i] = static_cast<uint8_t>(c >> (8 * i));
+		}
+		oc_ghash(y_, h_, lens, 16);
+		uint8_t ek[16]{};
+		oc_aes(ek, 16, key_, 32, j0_, OC_AES_CTR);
+		for (int i = 0; i < 16; ++i) {
+			tag[i] = y_[i] ^ ek[i];
+		}
+	}
+
+private:
+	uint8_t key_[32];
+	uint8_t h_[16];
+	uint8_t j0_[16];
+	uint8_t ctr_[16];
+	uint8_t y_[16]{};
+	size_t ad_size_{};
+	size_t size_{};
+};
+
+void aes256_ctr(uint8_t const* key, uint8_t const* ctr, uint8_t* out, uint8_t const* in, size_t size)
+{
+	if (out != in) {
+		memmove(out, in, size);
+	}
+	oc_aes(out, size, key, 32, ctr, OC_AES_CTR);
+}
+
+void curve25519_mul(uint8_t* out, uint8_t const* scalar, uint8_t const* point)
+{
+	// An all-zero answer (a small-order point) stays all zeros, as Nettle's did
+	oc_x25519(out, scalar, point);
+}
