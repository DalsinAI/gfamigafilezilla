+// A tray icon where the toolkit has one (not on macOS, nor on the Amiga's
+// GFOpenWX Toolkit until it offers a Workbench AppIcon for it)
+#if !defined(__WXMAC__) && wxUSE_TASKBARICON
+#define FZ_TRAYICON 1
+#else
+#define FZ_TRAYICON 0
+#endif
+
 #include "../commonui/updater.h"
 
 #include <list>
@@ -165,8 +173,10 @@
 	void OnChildFocused(wxChildFocusEvent& event);
 #else
 	void OnIconize(wxIconizeEvent& event);
+#if FZ_TRAYICON
 	void OnTaskBarClick(wxTaskBarIconEvent&);
 #endif
+#endif
 #ifdef __WXGTK__
 	void OnTaskBarClick_Delayed(wxCommandEvent& event);
 #endif
@@ -192,7 +202,7 @@
 
 	CQueue* m_pQueuePane{};
 
-#ifndef __WXMAC__
+#if FZ_TRAYICON
