+
+// AmigaDOS quoting: inside "...", a quote is *" and a star is **.
+std::string amiga_quote(native_string const& arg)
+{
+	std::string ret = "\"";
+	for (char c : arg) {
+		if (c == '"' || c == '*') {
+			ret += '*';
+		}
+		else if (c == '\n') {
+			ret += "*N";
+			continue;
+		}
+		ret += c;
+	}
+	ret += '"';
+	return ret;
+}
+}
