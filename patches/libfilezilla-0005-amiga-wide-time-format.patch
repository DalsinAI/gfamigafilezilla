AmigaOS: libnix's wcsftime() writes garbage (FileZilla's file lists showed
boxes and question marks for every date), so the wide-string time formats
go through strftime() and UTF-8.

--- a/lib/time.cpp
+++ b/lib/time.cpp
@@ -1,4 +1,5 @@
 #include "libfilezilla/time.hpp"
+#include "libfilezilla/string.hpp"
 
 #include "libfilezilla/format.hpp"
 
@@ -656,7 +657,12 @@
 	CrtAssertSuppressor suppressor;
 #endif
 
+#ifdef __AMIGA__
+	(void)buf;
+	return verify_format(fz::to_utf8(fmt));
+#else
 	return wcsftime(buf, sizeof(buf) / sizeof(wchar_t), fmt.c_str(), &t) != 0;
+#endif
 }
 
 duration operator-(datetime const& a, datetime const& b)
@@ -693,10 +699,16 @@
 #ifdef __VISUALC__
 	CrtAssertSuppressor suppressor;
 #endif
+#ifdef __AMIGA__
+	(void)buf;
+	(void)t;
+	return fz::to_wstring_from_utf8(format(fz::to_utf8(fmt), z));
+#else
 	wcsftime(buf, count - 1, fmt.c_str(), &t);
 	buf[count - 1] = 0;
 
 	return buf;
+#endif
 }
 
 time_t datetime::get_time_t() const
